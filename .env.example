# Copy to .env.local and fill in values from your Supabase project.
# Never commit .env.local.

# --- Public: safe in the browser, protected by Row-Level Security -------------
# Supabase → Project Settings → API (Data API URL) and API Keys (publishable key).
NEXT_PUBLIC_SUPABASE_URL=
# The publishable key (sb_publishable_...). A legacy "anon" key also works here.
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=
# Optional: absolute site URL used in auth emails (defaults to the request host).
# NEXT_PUBLIC_SITE_URL=http://localhost:3000

# --- Server/tooling only: NEVER prefix with NEXT_PUBLIC_ -----------------------
# Secret key (sb_secret_...). Used by `npm run db:check:remote` (fictional test accounts)
# and, server-side only, by the credential anchoring worker (two service-role-only functions).
SUPABASE_SECRET_KEY=
# Postgres connection string (Supabase → Connect → Session pooler) for `npm run db:push`.
SUPABASE_DB_URL=

# Real child data stays disabled until the privacy/legal review is complete.
# The database enforces this too (public.app_settings.real_child_data_enabled).
REAL_CHILD_DATA_ENABLED=false

# --- Credential anchoring on Base Sepolia (Phase 7, server-only; docs/CREDENTIALS.md) ------
# Off unless "true". When off, credentials are still issued and verifiable offchain.
CREDENTIAL_ANCHORING_ENABLED=false
# Platform issuer key for Base Sepolia ONLY (0x + 64 hex). A dedicated testnet key holding a
# small amount of Base Sepolia test ETH. Never a mainnet key, never NEXT_PUBLIC_.
CREDENTIAL_ISSUER_PRIVATE_KEY=
# Optional dedicated RPC (defaults to the rate-limited public https://sepolia.base.org).
# BASE_SEPOLIA_RPC_URL=

# --- One-click demo accounts ("Try the demo" button; README §2) --------------------------
# Server-only. When "true", sign-up / sign-in / get-started show a button that creates a fresh,
# already-confirmed fictional parent + demo child (PIN 2580), deleted automatically after 48 h.
# Needs SUPABASE_SECRET_KEY. Rate-limited (3/hour per visitor, 200/day). Rebuild after changing.
DEMO_ACCOUNTS_ENABLED=false
